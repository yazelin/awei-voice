# Comma-separated exact production web origins. Do not use `*`, paths, or a
# trailing slash. Non-local origins must be HTTPS.
AWEI_ALLOWED_WEB_ORIGINS=https://yazelin.github.io
AWEI_ALLOW_LOCALHOST_ORIGINS=true
AWEI_REQUIRE_WEB_ORIGIN=false

# `mock` is deterministic test audio, never real Taiwanese Hokkien speech.
TAIGI_PROVIDER_MODE=concrete
TAIGI_TRANSLATOR_PROVIDER=ollama
TAIGI_TTS_PROVIDER=mms
TAIGI_MANDARIN_TTS_PROVIDER=edge
TAIGI_EDGE_TTS_VOICE=zh-TW-HsiaoChenNeural
TAIGI_EDGE_TTS_TIMEOUT_SECONDS=45
TAIGI_OLLAMA_BASE_URL=http://ollama:11434
TAIGI_OLLAMA_MODEL=qwen3:4b-instruct-2507-q4_K_M
TAIGI_MMS_MODEL=facebook/mms-tts-nan
TAIGI_MMS_DEVICE=cpu
TAIGI_MMS_TIMEOUT_SECONDS=180

# Hosted alternatives. These send text to the configured external provider;
# do not describe them as the local/offline path. Leave blank for Ollama+MMS.
TAIGI_OPENAI_BASE_URL=
TAIGI_OPENAI_API_KEY=
TAIGI_OPENAI_MODEL=
TAIGI_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
TAIGI_GEMINI_API_KEY=
TAIGI_GEMINI_MODEL=gemini-3.5-flash
TAIGI_REMOTE_TTS_URL=
TAIGI_REMOTE_TTS_API_KEY=

# Local single-user development may leave authentication off. Any remotely
# reachable deployment should enable it and configure only SHA-256 digests.
TAIGI_REQUIRE_ACCESS_TOKEN=false
# Always enabled by the web wrapper. Kept explicit here so rendered deployment
# configuration makes the public anonymous quota boundary visible.
TAIGI_ENFORCE_OPEN_ACCESS_QUOTA=true
TAIGI_ALLOW_DIRECT_SYNTHESIS=false
TAIGI_ACCESS_TOKEN_HASHES=
TAIGI_QUOTA_DATABASE_PATH=/var/lib/awei/quota.sqlite3
TAIGI_DAILY_SUBJECT_JOB_LIMIT=500
TAIGI_DAILY_SUBJECT_CHARACTER_LIMIT=200000
TAIGI_DAILY_GLOBAL_JOB_LIMIT=500
TAIGI_DAILY_GLOBAL_CHARACTER_LIMIT=200000
